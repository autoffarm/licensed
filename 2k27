local function make(class, parent, props)
    local inst = Instance.new(class)
    for key, value in pairs(props) do
        inst[key] = value
    end
    inst.Parent = parent
    return inst
end

local function addCorner(parent, radius)
    return make("UICorner", parent, {CornerRadius = radius})
end

local function gradient(parent, rotation, colors, transparency)
    local g = make("UIGradient", parent, {Rotation = rotation, Color = colors})
    if transparency then g.Transparency = transparency end
    return g
end

-- draws a straight line between two points using a rotated frame
local function line(parent, x1, y1, x2, y2, thick, color, transparency, z)
    local dx, dy = x2 - x1, y2 - y1
    local len = math.sqrt(dx * dx + dy * dy)
    return make("Frame", parent, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2),
        Size = UDim2.new(0, len, 0, thick),
        Rotation = math.deg(math.atan2(dy, dx)),
        BackgroundColor3 = color,
        BackgroundTransparency = transparency,
        BorderSizePixel = 0,
        ZIndex = z or 1,
    })
end

local function block(parent, x, y, w, h, color, transparency, radius, z)
    local f = make("Frame", parent, {
        Position = UDim2.new(0, x, 0, y),
        Size = UDim2.new(0, w, 0, h),
        BackgroundColor3 = color,
        BackgroundTransparency = transparency,
        BorderSizePixel = 0,
        ZIndex = z or 1,
    })
    if radius then addCorner(f, radius) end
    return f
end

