    gradient(toggle, 90, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 200, 220)))

    local toggleStroke = make("UIStroke", toggle, {
        Color = Color3.fromRGB(255, 205, 120),
        Thickness = 1.5,
        Transparency = initialVal and 0.2 or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })

    local stateLabel = make("TextLabel", toggle, {
        Size = UDim2.new(0, 26, 1, 0),
        Position = initialVal and UDim2.new(0, 7, 0, 0) or UDim2.new(1, -33, 0, 0),
        BackgroundTransparency = 1,
        Text = initialVal and "ON" or "OFF",
        TextColor3 = initialVal and Color3.fromRGB(70, 25, 0) or Color3.fromRGB(150, 120, 190),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
    })

    local knob = make("Frame", toggle, {
        Size = UDim2.new(0, 22, 0, 22),
        Position = initialVal and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    })
    addCorner(knob, UDim.new(1, 0))

    local knobIcon = make("TextLabel", knob, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = initialVal and "🎃" or "💀",
        TextSize = 13,
    })

    local rowStroke = parent:FindFirstChild("RowStroke")
    local rowGlow = rowGlows[parent]

    local state = initialVal
    toggle.MouseButton1Click:Connect(function()
        state = not state
        local goalPos = state and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
        local goalBg = state and TOGGLE_ON or TOGGLE_OFF
        TweenService:Create(toggle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = goalBg}):Play()
        TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = goalPos}):Play()
        TweenService:Create(toggleStroke, TweenInfo.new(0.2), {Transparency = state and 0.2 or 1}):Play()

        stateLabel.Text = state and "ON" or "OFF"
        TweenService:Create(stateLabel, TweenInfo.new(0.2), {
            Position = state and UDim2.new(0, 7, 0, 0) or UDim2.new(1, -33, 0, 0),
            TextColor3 = state and Color3.fromRGB(70, 25, 0) or Color3.fromRGB(150, 120, 190),
        }):Play()
        knobIcon.Text = state and "🎃" or "💀"

        if rowStroke then
            TweenService:Create(rowStroke, TweenInfo.new(0.2), {
                Color = state and ROW_STROKE_ON or ROW_STROKE_OFF,
                Transparency = state and 0.1 or 0.55,
            }):Play()
        end
        if rowGlow then rowGlow.on = state end
        callback(state)
    end)
    return toggle
end

