-- =====================================================================
--  animation loop
-- =====================================================================
local animStart = os.clock()
local flashT0 = 0.5
local nextFlash = 8
local lastStatus = nil
local lastAfk = nil

local function flashIntensity(dt)
    if dt < 0 then return 0 end
    if dt < 0.08 then return 1 end
    if dt < 0.16 then return 0.2 end
    if dt < 0.26 then return 0.85 end
    if dt < 0.7 then return 0.85 * (1 - (dt - 0.26) / 0.44) end
    return 0
end

local animConnection = RunService.Heartbeat:Connect(function(dt)
    local t = os.clock() - animStart

    -- pulsing, colour-shifting outer glow
    local gc = ORANGE:Lerp(PURPLE, 0.5 + 0.5 * math.sin(t * 0.6))
    for _, g in ipairs(glows) do
        g.frame.BackgroundColor3 = gc
        g.frame.BackgroundTransparency = g.base + 0.02 * math.sin(t * 2)
    end

    for _, f in ipairs(flakes) do
        f.y -= f.speed * dt
        if f.y < -6 then
            f.y = snowH + 6
            f.x = rng:NextNumber(0, snowW)
        end
        f.frame.Position = UDim2.new(0, f.x + math.sin(t * f.freq + f.phase) * f.sway, 0, f.y)
    end

    for _, s in ipairs(stars) do
        s.frame.BackgroundTransparency = 0.25 + 0.6 * (0.5 + 0.5 * math.sin(t * s.freq + s.phase))
    end

    for _, a in ipairs(auroras) do
        a.holder.Position = UDim2.new(0, a.x + math.sin(t * a.freq + a.phase) * a.amp, 0, a.y + math.sin(t * a.freq * 0.7 + a.phase) * 4)
    end

    for _, c in ipairs(clouds) do
        local span = WIN_W + c.w + 40
        local x = (c.x + t * c.speed) % span - c.w - 20
        c.frame.Position = UDim2.new(0, x, 0, c.y + math.sin(t * 0.5 + c.x) * 3)
    end

    for _, w in ipairs(windows) do
        local flick = 0.5 + 0.5 * math.sin(t * w.freq + w.phase) * math.sin(t * w.freq * 2.7)
        w.frame.BackgroundTransparency = 0.05 + 0.4 * flick
    end

    for _, p in ipairs(pulses) do
        p.frame.BackgroundTransparency = p.base + p.amp * math.sin(t * p.freq + p.phase)
    end

    for _, r in ipairs(moonRings) do
        r.frame.BackgroundTransparency = r.base - 0.015 + 0.015 * math.sin(t * 0.8)
    end

    for _, d in ipairs(drips) do
        d.frame.Size = UDim2.new(0, d.w, 0, d.base * (0.75 + 0.25 * math.sin(t * d.freq + d.phase)))
    end

    for _, b in ipairs(bats) do
        b.frame.Position = UDim2.new(
            0, b.cx + math.sin(t * b.freq + b.phase) * b.range,
            0, b.cy + math.sin(t * b.freq * 2.3 + b.phase) * 9
        )
        b.frame.Rotation = math.cos(t * b.freq + b.phase) * 18
    end

    for _, g in ipairs(ghosts) do
        g.frame.Position = UDim2.new(
            0, g.cx + math.sin(t * g.freq + g.phase) * g.range,
            0, g.cy + math.sin(t * g.freq * 1.7 + g.phase) * 8
        )
        g.frame.TextTransparency = 0.5 + 0.2 * math.sin(t * 1.3 + g.phase)
    end

    -- lightning
    if t > nextFlash then
        flashT0 = t
        nextFlash = t + rng:NextNumber(6, 13)
    end
    local fi = flashIntensity(t - flashT0)
    Flash.BackgroundTransparency = 1 - 0.2 * fi
    for _, piece in ipairs(boltPieces) do
        piece.BackgroundTransparency = 1 - fi
    end

    -- hanging spider
    local threadLen = 16 + 14 * (0.5 + 0.5 * math.sin(t * 0.9))
    SpiderThread.Size = UDim2.new(0, 1, 0, threadLen)
    Spider.Position = UDim2.new(0, 285, 0, threadLen - 1)

    -- header
    StrokeGradient.Rotation = (t * 40) % 360
    SnowIcon.Rotation = math.sin(t * 2.2) * 14
    IconRing.BackgroundTransparency = 0.86 + 0.08 * math.sin(t * 2.6)
    IconRing.Size = UDim2.new(0, 46 + 4 * math.sin(t * 2.6), 0, 46 + 4 * math.sin(t * 2.6))
    Title.TextTransparency = (math.sin(t * 37) * math.sin(t * 11) > 0.94) and 0.45 or 0

    -- row glow for enabled features
    for _, rg in pairs(rowGlows) do
        local target = rg.on and (0.11 + 0.04 * math.sin(t * 3)) or 0
        rg.a += (target - rg.a) * math.min(1, dt * 8)
        rg.frame.BackgroundTransparency = 1 - rg.a
    end

    -- status pill
    local statusText = enabled and "Haunting coins..." or "Sleeping in the crypt"
    if statusText ~= lastStatus then
        lastStatus = statusText
        StatusLabel.Text = statusText
    end
    if enabled then
        StatusDot.BackgroundColor3 = Color3.fromRGB(120, 255, 90)
        StatusDot.BackgroundTransparency = 0.5 - 0.5 * math.sin(t * 5) * 0.7
    else
        StatusDot.BackgroundColor3 = Color3.fromRGB(150, 100, 200)
        StatusDot.BackgroundTransparency = 0.2
    end
    local afkText = afkActive and "AFK guard: ON" or "AFK guard: OFF"
    if afkText ~= lastAfk then
        lastAfk = afkText
        AfkLabel.Text = afkText
        AfkLabel.TextColor3 = afkActive and Color3.fromRGB(150, 255, 110) or Color3.fromRGB(160, 130, 200)
    end
end)

ScreenGui.Destroying:Connect(function()
    animConnection:Disconnect()
end)

CloseBtn.MouseButton1Click:Connect(function()
    animConnection:Disconnect()
    unloadScript()
    ScreenGui:Destroy()
end)

local dragging, dragStart, startPos = false, nil, nil
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

loadScript()
