local Row1 = createRow("Auto Farm", "Collects coins", "$", Color3.fromRGB(255, 205, 90), Color3.fromRGB(255, 150, 60), 62)
local Row2 = createRow("Anti-AFK", "Prevents idle kick", "Zz", Color3.fromRGB(170, 140, 255), Color3.fromRGB(110, 100, 230), 114)

local TOGGLE_OFF = Color3.fromRGB(38, 52, 90)
local TOGGLE_ON = Color3.fromRGB(110, 225, 255)

local function createToggle(parent, initialVal, callback)
    local toggle = make("TextButton", parent, {
        Size = UDim2.new(0, 50, 0, 26),
        Position = UDim2.new(1, -62, 0.5, -13),
        BackgroundColor3 = initialVal and TOGGLE_ON or TOGGLE_OFF,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
    })
    addCorner(toggle, UDim.new(1, 0))
    gradient(toggle, 90, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 225, 255)))

    local toggleStroke = make("UIStroke", toggle, {
        Color = Color3.fromRGB(150, 230, 255),
        Thickness = 1.5,
        Transparency = initialVal and 0.25 or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })

    local knob = make("Frame", toggle, {
        Size = UDim2.new(0, 20, 0, 20),
        Position = initialVal and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    })
    addCorner(knob, UDim.new(1, 0))

    local rowStroke = parent:FindFirstChild("RowStroke")

    local state = initialVal
    toggle.MouseButton1Click:Connect(function()
        state = not state
        local goalPos = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        local goalBg = state and TOGGLE_ON or TOGGLE_OFF
        TweenService:Create(toggle, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = goalBg}):Play()
        TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = goalPos}):Play()
        TweenService:Create(toggleStroke, TweenInfo.new(0.18), {Transparency = state and 0.25 or 1}):Play()
        if rowStroke then
            TweenService:Create(rowStroke, TweenInfo.new(0.18), {
                Color = state and ROW_STROKE_ON or ROW_STROKE_OFF,
                Transparency = state and 0.15 or 0.55,
            }):Play()
        end
        callback(state)
    end)
    return toggle
end

