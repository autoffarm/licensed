-- animation loop (snow, stars, aurora, shimmering border, spinning icon) --
local animStart = os.clock()
local animConnection = RunService.Heartbeat:Connect(function(dt)
    local t = os.clock() - animStart

    for _, f in ipairs(flakes) do
        f.y += f.speed * dt
        if f.y > snowH + 6 then
            f.y = -6
            f.x = rng:NextNumber(0, snowW)
        end
        f.frame.Position = UDim2.new(0, f.x + math.sin(t * f.freq + f.phase) * f.sway, 0, f.y)
    end

    for _, s in ipairs(stars) do
        s.frame.BackgroundTransparency = 0.25 + 0.6 * (0.5 + 0.5 * math.sin(t * s.freq + s.phase))
    end

    for _, a in ipairs(auroras) do
        a.holder.Position = UDim2.new(0, a.x + math.sin(t * a.freq + a.phase) * a.amp, 0, a.y + math.sin(t * a.freq * 0.7 + a.phase) * 4)
    end

    StrokeGradient.Rotation = (t * 40) % 360
    SnowIcon.Rotation = (t * 24) % 360
end)

